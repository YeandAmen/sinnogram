# Local testing. Never commit a real .env with credentials.
AXIS_PROVIDER=osm
# Public beta: connect a private Vercel Blob store and initialize its lease object.
# SINNOGRAM_PUBLIC_BETA=1
# BLOB_READ_WRITE_TOKEN=
# SINNOGRAM_GATE_URL=https://STORE.private.blob.vercel-storage.com/provider-slot.json
# Optional Google routing (requires billing and API quotas):
# GOOGLE_MAPS_API_KEY=

# Shared place registry: uses a separate private Blob object in the existing store.
# Default object is derived from SINNOGRAM_GATE_URL when Blob credentials are set.
# SINNOGRAM_PLACE_REGISTRY_URL=https://STORE.private.blob.vercel-storage.com/sinnogram-place-registry-v1.json
# Set a random token of at least 24 characters for the operator review page/API.
# SINNOGRAM_PLACE_REVIEW_TOKEN=
# Local/container development only; mount this path on persistent storage in containers.
# SINNOGRAM_PLACE_FILE=./.local/place-registry.json
